{
  "manifest_version": 3,
  "name": "Phaser DevTools",
  "description": "A Chrome DevTools panel for inspecting Phaser 3 games.",
  "version": "0.1.0",
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
